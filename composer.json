{
  "name": "miguilim/filament-auto-panel",
  "description": "Construct your Filament panel Resources and Relation Managers at execution time like magic.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Miguilim\\FilamentAutoPanel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Miguilim\\FilamentAutoPanel\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "filament/filament": "^5.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.8"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Miguilim\\FilamentAutoPanel\\FilamentAutoPanelProvider"
      ]
    }
  }
}
